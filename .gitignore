__pycache__/
*.pyc
.pytest_cache/

# ── frontend ──
v2/frontend/node_modules/
v2/frontend/dist/

# ── backend ──
# SQLite (구독자 웹훅 포함 가능)
v2/backend/*.db
v2/backend/.pytest_cache/
